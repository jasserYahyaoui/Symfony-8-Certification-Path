{
    "name": "jasseryahyaoui/cert-behavior-checks",
    "description": "Executes the central claims the course teaches against the exam versions (Symfony 8.0, PHP 8.4). Separate from the site generator, which runs Symfony 7.4.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "psr/simple-cache": "^3.0",
        "symfony/browser-kit": "8.0.*",
        "symfony/cache": "8.0.*",
        "symfony/clock": "8.0.*",
        "symfony/config": "8.0.*",
        "symfony/console": "8.0.*",
        "symfony/dependency-injection": "8.0.*",
        "symfony/error-handler": "8.0.*",
        "symfony/event-dispatcher": "8.0.*",
        "symfony/filesystem": "8.0.*",
        "symfony/finder": "8.0.*",
        "symfony/form": "8.0.*",
        "symfony/framework-bundle": "8.0.*",
        "symfony/http-client": "8.0.*",
        "symfony/http-foundation": "8.0.*",
        "symfony/http-kernel": "8.0.*",
        "symfony/messenger": "8.0.*",
        "symfony/options-resolver": "8.0.*",
        "symfony/process": "8.0.*",
        "symfony/property-access": "8.0.*",
        "symfony/property-info": "8.0.*",
        "symfony/routing": "8.0.*",
        "symfony/runtime": "8.0.*",
        "symfony/security-core": "8.0.*",
        "symfony/serializer": "8.0.*",
        "symfony/string": "8.0.*",
        "symfony/translation": "8.0.*",
        "symfony/twig-bridge": "8.0.*",
        "symfony/type-info": "8.0.*",
        "symfony/validator": "8.0.*",
        "symfony/var-dumper": "8.0.*",
        "symfony/var-exporter": "8.0.*",
        "symfony/yaml": "8.0.*",
        "twig/twig": "^3.22"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
