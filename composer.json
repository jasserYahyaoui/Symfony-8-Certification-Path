{
    "name": "jasseryahyaoui/symfony-8-certification-path",
    "description": "Certification-focused learning and assessment system for the Symfony 8 Certification.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/console": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "CertPath\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CertPath\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "validate-content": "php bin/cert validate",
        "coverage": "php bin/cert coverage",
        "build": "php bin/cert build",
        "test": "phpunit",
        "gate": [
            "@validate-content",
            "@coverage",
            "@test"
        ]
    }
}
